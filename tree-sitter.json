{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "blk",
      "camelcase": "Blk",
      "title": "BLK",
      "scope": "source.blk",
      "path": ".",
      "file-types": [
        "blk"
      ],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "Dagor BLK (DataBlock) text format grammar for tree-sitter",
    "authors": [
      {
        "name": "Gaijin Entertainment"
      },
      {
        "name": "Anton Zinovyev",
        "email": "xog3@yandex.ru"
      }
    ],
    "links": {
      "repository": "https://github.com/GaijinEntertainment/tree-sitter-blk"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
